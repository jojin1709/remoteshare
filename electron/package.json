{
  "name": "remote-share-host",
  "version": "1.0.0",
  "description": "RemoteShare Host — Ultra-Fast Free Screen Sharing",
  "main": "main.js",
  "author": "JOJIN JOHN",
  "scripts": {
    "start": "electron .",
    "build:installer": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "build:win": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.jojin.remoteshare",
    "productName": "RemoteShare",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "directories": {
      "output": "build-output"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "RemoteShare",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true
    },
    "files": [
      "**/*",
      "!build-output/*",
      "!release/*",
      "!dist/*"
    ]
  },
  "dependencies": {
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
